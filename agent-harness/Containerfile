# Cat Herder agent harness image (runs inside the sandbox pod).
# Build context is the repo root (see Tiltfile) so we can bake in the source for
# local review.
FROM python:3.12-slim

WORKDIR /app

COPY agent-harness/pyproject.toml ./
COPY agent-harness/src ./src

RUN pip install --no-cache-dir .

# Bake in the repo source (read-only review) for local dev — the agent reads /repo.
COPY . /repo

CMD ["python", "-m", "cat_herder_harness.server"]
