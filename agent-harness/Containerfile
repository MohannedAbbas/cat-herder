# Cat Herder agent harness image (runs inside the sandbox pod).
FROM python:3.12-slim

# uv, taken from its official image (keeps the base python image untouched).
# Pinned so builds don't silently change on future uv releases.
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY src ./src

# git (clone), curl + build-essential + perl (Rust/ring build), ca-certificates (HTTPS).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl build-essential perl \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain (cargo/rustc) so the agent can build/test the target repo.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal

# Install deps + the project into a venv, frozen to the lockfile.
RUN uv sync --frozen --no-dev --no-editable --no-cache

# Make the venv's python and the Rust toolchain available on PATH.
ENV PATH="/app/.venv/bin:/root/.cargo/bin:$PATH"

# Working directory the target repo is cloned into (empty by default).
RUN mkdir -p /repo

CMD ["python", "-m", "cat_herder_harness.server"]
