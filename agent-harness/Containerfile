# Cat Herder agent harness image — Python-only base (runs inside the sandbox pod).
#
# This is the default harness image: Python + uv + the harness venv, nothing else.
# For target repos that need a Rust toolchain (cargo/rustc + a C linker + perl for
# `ring`), build agent-harness/Containerfile.rust, which layers the toolchain on top
# of this image (see its --build-arg BASE_IMAGE).
FROM python:3.12-slim

# uv, taken from its official image (keeps the base python image untouched).
# Pinned so builds don't silently change on future uv releases.
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY src ./src

# git (clone) and ca-certificates (HTTPS) are all the Python harness needs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install deps + the project into a venv, frozen to the lockfile.
RUN uv sync --frozen --no-dev --no-editable --no-cache \
    && rm -rf /root/.cache/uv

# Make the venv's python available on PATH.
ENV PATH="/app/.venv/bin:$PATH"

# Working directory the target repo is cloned into (empty by default).
RUN mkdir -p /repo

CMD ["python", "-m", "cat_herder_harness.server"]
